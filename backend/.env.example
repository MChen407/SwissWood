# ===== Application =====
NODE_ENV=development
PORT=4000
API_PREFIX=/api
HOST=0.0.0.0

# ===== CORS =====
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# URL du frontend (redirection après OAuth Google)
FRONTEND_URL=http://localhost:5173

# ===== Database (MySQL) =====
DATABASE_URL="mysql://root:password@localhost:3306/swisswood"

# ===== JWT =====
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== OAuth Google =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ===== Security =====
# Max login attempts per window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ===== Logging =====
LOG_LEVEL=info

# ===== Seed (premier super admin) =====
SEED_ADMIN_EMAIL=admin@swisswood.ch
SEED_ADMIN_PASSWORD=Admin123!
