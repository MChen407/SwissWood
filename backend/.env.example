# ===== Application =====
NODE_ENV=development
PORT=4000
API_PREFIX=/api
HOST=0.0.0.0

# ===== CORS =====
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# URL du frontend (redirection après OAuth Google)
FRONTEND_URL=http://localhost:5173

# URL publique de l'API (utilisée notamment pour les e-mails)
API_PUBLIC_URL=http://localhost:4000

# ===== Database (MySQL) =====
DATABASE_URL="mysql://root:password@localhost:3306/swisswood"

# ===== Cloudinary (stockage des images uploadées) =====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=swisswood

# ===== JWT =====
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== OAuth Google =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ===== Security =====
# Max login attempts per window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ===== E-mail (SMTP) =====
# Si SMTP_HOST est vide, les e-mails sont simulés (contenu affiché en console serveur)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SwissWood <no-reply@swisswood.ch>"

# ===== Coordonnées bancaires (instructions virement) =====
BANK_OWNER=SwissWood SA
BANK_IBAN="CH00 0000 0000 0000 0000 0"
BANK_BIC=SWISCHZZ

# ===== Facturation =====
COMPANY_ADDRESS="Adresse à compléter"
COMPANY_ZIP_CITY="Ville, Pays"
COMPANY_VAT_NUMBER="CHE-XXX.XXX.XXX"
INVOICE_VAT_RATE=0

# ===== Code de sécurité 3DS (simulation SMS) =====
PAYMENT_CODE_SECRET=change-me-to-a-long-random-secret
PAYMENT_CODE_TTL_MINUTES=10
PAYMENT_CODE_MAX_ATTEMPTS=3

# ===== Logging =====
LOG_LEVEL=info

# ===== Seed (premier super admin) =====
SEED_ADMIN_EMAIL=admin@swisswood.ch
SEED_ADMIN_PASSWORD=Admin123!
