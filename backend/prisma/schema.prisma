// =====================================================================
// SwissWood — Modèle de données (MySQL)
// Port du schéma PostgreSQL (Supabase) vers Prisma + MySQL.
//
// Les IDs utilisent des UUID (CHAR(36)) pour rester compatibles avec
// les types `string` attendus par le frontend Vue.
//
// Les champs JSON utilisent le type natif MySQL JSON.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum Role {
  customer
  admin
  super_admin
}

enum ProductEssence {
  Teck
  Iroko
  Pin
  Sapin
}

enum OrderStatus {
  pending
  confirmed
  preparing
  shipped
  delivered
  cancelled
}

enum OrderPaymentStatus {
  pending
  awaiting_transfer
  paid
  failed
  refunded
}

enum PaymentMethod {
  card
  bank_transfer
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

// =====================================================================
// USERS
// Fusion de "auth.users" + "profiles"
// =====================================================================

model User {
  id            String   @id @default(uuid()) @db.Char(36)
  email         String   @unique @db.VarChar(255)
  password      String?  @db.VarChar(255)
  googleId      String?  @unique @map("google_id") @db.VarChar(255)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(512)
  emailVerified Boolean  @default(false) @map("email_verified")

  firstName String @default("") @map("first_name") @db.VarChar(120)
  lastName  String @default("") @map("last_name") @db.VarChar(120)

  phone   String? @db.VarChar(30)
  address String? @db.VarChar(255)
  city    String? @db.VarChar(120)

  country String @default("Suisse") @db.VarChar(80)
  role    Role   @default(customer)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  refreshTokens RefreshToken[]
  favorites     Favorite[]
  orders        Order[]
  payments      Payment[]
  reviews       ProductReview[]

  @@index([role])
  @@map("users")
}

// =====================================================================
// TOKENS DE RAFRAÎCHISSEMENT
// =====================================================================

model RefreshToken {
  id         String    @id @default(uuid()) @db.Char(36)
  token      String    @unique @db.VarChar(255)
  userId     String    @map("user_id") @db.Char(36)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(6)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(6)
  replacedBy String?   @map("replaced_by") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =====================================================================
// PRODUCTS
// =====================================================================

model Product {
  id   String @id @default(uuid()) @db.Char(36)
  name String @db.VarChar(200)
  slug String @unique @db.VarChar(200)

  essence ProductEssence

  // IMPORTANT :
  // TEXT ne doit pas avoir de DEFAULT sur MySQL Railway.
  description String @db.Text

  priceEur  Int @default(0) @map("price_eur")
  priceUsd  Int @default(0) @map("price_usd")
  priceFcfa Int @default(0) @map("price_fcfa")
  stock     Int @default(0)

  // JSON : on conserve les defaults.
  dimensions      Json @default("{}")
  images          Json @default("[]")
  characteristics Json @default("{}")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  reviews    ProductReview[]
  favorites  Favorite[]
  orderItems OrderItem[]

  @@index([essence])
  @@index([isActive])
  @@index([priceEur])
  @@map("products")
}

// =====================================================================
// PRODUCT REVIEWS
// =====================================================================

model ProductReview {
  id        String @id @default(uuid()) @db.Char(36)
  productId String @map("product_id") @db.Char(36)
  userId    String @map("user_id") @db.Char(36)

  rating Int

  // TEXT : pas de DEFAULT.
  comment String @db.Text

  isApproved Boolean @default(false) @map("is_approved")
  isRejected Boolean @default(false) @map("is_rejected")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isApproved])
  @@map("product_reviews")
}

// =====================================================================
// FAVORITES
// =====================================================================

model Favorite {
  id        String @id @default(uuid()) @db.Char(36)
  userId    String @map("user_id") @db.Char(36)
  productId String @map("product_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

// =====================================================================
// ORDERS
// =====================================================================

model Order {
  id          String @id @default(uuid()) @db.Char(36)
  orderNumber String @unique @map("order_number") @db.VarChar(50)
  userId      String @map("user_id") @db.Char(36)

  status        OrderStatus        @default(pending)
  paymentMethod PaymentMethod      @map("payment_method")
  paymentStatus OrderPaymentStatus @default(pending) @map("payment_status")

  subtotalEur Int @default(0) @map("subtotal_eur")
  totalEur    Int @default(0) @map("total_eur")

  currency String @default("EUR") @db.VarChar(10)

  // JSON : on conserve le default.
  shippingAddress Json @default("{}") @map("shipping_address")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

// =====================================================================
// ORDER ITEMS
// =====================================================================

model OrderItem {
  id        String @id @default(uuid()) @db.Char(36)
  orderId   String @map("order_id") @db.Char(36)
  productId String @map("product_id") @db.Char(36)

  quantity Decimal @default(1)

  unit        String @default("pcs") @db.VarChar(20)
  unitPriceEur Int    @default(0) @map("unit_price_eur")

  // JSON : on conserve le default.
  customization Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

// =====================================================================
// PAYMENTS
// =====================================================================

model Payment {
  id      String @id @default(uuid()) @db.Char(36)
  orderId String @map("order_id") @db.Char(36)
  userId  String @map("user_id") @db.Char(36)

  method PaymentMethod
  status PaymentStatus @default(pending)

  amountEur Int    @default(0) @map("amount_eur")
  reference String @default("") @db.VarChar(80)

  // JSON : on conserve le default.
  // Cela permet à ton code existant de créer un Payment
  // sans fournir explicitement metadata.
  metadata Json @default("{}")

  // Code de sécurité 3DS (simulation SMS) : stocké hashé, jamais en clair.
  securityCodeHash       String?   @map("security_code_hash") @db.VarChar(255)
  securityCodeExpiresAt  DateTime? @map("security_code_expires_at") @db.DateTime(6)
  securityCodeAttempts   Int       @default(0) @map("security_code_attempts")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
  @@map("payments")
}

// =====================================================================
// CMS CONTENT
// =====================================================================

model CmsContent {
  id  String @id @default(uuid()) @db.Char(36)
  key String @unique @db.VarChar(100)

  // TEXT : pas de DEFAULT.
  value String @db.Text

  type  String @default("text") @db.VarChar(20)
  label String @default("") @db.VarChar(200)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cms_content")
}

// =====================================================================
// CONTACT MESSAGES
// =====================================================================

model ContactMessage {
  id      String @id @default(uuid()) @db.Char(36)
  name    String @db.VarChar(120)
  email   String @db.VarChar(255)
  subject String @db.VarChar(200)

  message String @db.Text

  status String @default("new") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  @@index([createdAt])
  @@map("contact_messages")
}

// =====================================================================
// STATS VUE AGRÉGÉE
// Dashboard admin — optionnelle via requêtes
// =====================================================================

// =====================================================================
// MEDIA (images uploadées, stockées en base — LONGBLOB)
// =====================================================================

model Media {
  id       String   @id @default(uuid()) @db.Char(36)
  filename String   @db.VarChar(255)
  mimetype String   @db.VarChar(100)
  size     Int
  data     Bytes    @db.LongBlob

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  @@index([createdAt])
  @@map("media")
}